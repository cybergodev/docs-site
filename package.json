{
  "name": "cybergodev-docs",
  "version": "1.0.0",
  "description": "CyberGo project documentation website",
  "type": "module",
  "scripts": {
    "dev": "vitepress dev docs --port 15310",
    "build": "tsx scripts/generate-search-index.ts && node --max-old-space-size=8192 ./node_modules/vitepress/bin/vitepress.js build docs && tsx scripts/fix-clean-urls.ts && tsx scripts/generate-project-redirects.ts && tsx scripts/generate-moved-redirects.ts && tsx scripts/generate-llms.ts && tsx scripts/generate-md-mirror.ts",
    "precheck": "npm run lint:autocorrect && npm run format:check && npm run typecheck && npm run check:projects && npm run build && npm run audit",
    "precheck:go": "npm run audit:api && npm run check:code -- --all",
    "preview": "vitepress preview docs",
    "search-index": "tsx scripts/generate-search-index.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "vue-tsc --noEmit",
    "check:projects": "tsx scripts/check-projects-sync.ts",
    "check:code": "tsx scripts/check-code-samples.ts",
    "audit": "tsx scripts/audit-locales.ts",
    "audit:api": "tsx scripts/audit-api.ts",
    "lint:autocorrect": "tsx scripts/lint-autocorrect.ts",
    "fix:autocorrect": "tsx scripts/lint-autocorrect.ts --fix",
    "setup:autocorrect": "tsx scripts/setup-autocorrect.ts",
    "prepare": "tsx scripts/prepare.ts"
  },
  "keywords": [
    "go",
    "golang",
    "docs",
    "vitepress"
  ],
  "author": "CyberGo",
  "license": "MIT",
  "devDependencies": {
    "@huacnlee/autocorrect": "^2.16.2",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^26.6.4",
    "ignore": "^7.0.12",
    "js-yaml": "^5.4.3",
    "minisearch": "^7.2.0",
    "prettier": "^3.9.9",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitepress": "^1.6.4",
    "vue-tsc": "^3.3.12"
  }
}
